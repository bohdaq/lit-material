{
  "name": "@lit-material/devtools",
  "version": "1.2.0",
  "description": "Development-time devtools for lit-material apps: Redux DevTools extension support and time travel for @lit-material/store, a router navigation log, and an in-page inspector panel (lit-material-devtools).",
  "license": "MIT",
  "author": {
    "name": "bohdaq",
    "email": "bohdaq@gmail.com",
    "url": "https://github.com/bohdaq"
  },
  "homepage": "https://lit.rws8.tech/guides/testing/",
  "bugs": "https://github.com/bohdaq/lit-material/issues",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bohdaq/lit-material.git",
    "directory": "packages/devtools"
  },
  "keywords": [
    "lit",
    "web-components",
    "lit-material",
    "devtools",
    "redux-devtools",
    "time-travel",
    "debugging"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./panel.js": {
      "types": "./dist/panel.d.ts",
      "default": "./dist/panel.js"
    },
    "./devtools-panel.js": {
      "types": "./dist/devtools-panel.d.ts",
      "default": "./dist/devtools-panel.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./jsx": {
      "types": "./types/jsx.d.ts"
    },
    "./vue": {
      "types": "./types/vue.d.ts"
    }
  },
  "files": [
    "dist",
    "custom-elements.json",
    "types"
  ],
  "web-types": "./dist/web-types.json",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "web-test-runner && node --import tsx --test src/*.ssr.test.ts",
    "analyze": "custom-elements-manifest analyze --litelement --globs \"src/**/*.ts\" --exclude \"src/**/*.test.ts\" --exclude \"src/**/*.ssr.test.ts\""
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "peerDependencies": {
    "@lit/react": "^1.0.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@lit/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lit-labs/ssr": "^3.3.1",
    "@lit-material/router": "workspace:*",
    "@lit-material/store": "workspace:*",
    "@open-wc/testing": "^4.0.0",
    "@web/dev-server-esbuild": "^1.0.0",
    "@web/test-runner": "^0.19.0",
    "@web/test-runner-commands": "^0.9.0",
    "@web/test-runner-playwright": "^0.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "customElements": "custom-elements.json"
}
