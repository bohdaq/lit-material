{
  "name": "@lit-material/text-field",
  "version": "0.4.1",
  "description": "Material Design 3 text field web components: lit-material-text-field (single-line) and lit-material-textarea (multi-line) — filled + outlined, validation states.",
  "license": "MIT",
  "author": {
    "name": "bohdaq",
    "email": "bohdaq@gmail.com",
    "url": "https://github.com/bohdaq"
  },
  "homepage": "https://lit.rws8.tech/components/text-field/",
  "bugs": "https://github.com/bohdaq/lit-material/issues",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bohdaq/lit-material.git",
    "directory": "packages/text-field"
  },
  "keywords": [
    "lit",
    "web-components",
    "lit-material",
    "material-design",
    "material-design-3",
    "text-field",
    "textarea",
    "input",
    "form"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./text-field.js": {
      "types": "./dist/text-field.d.ts",
      "default": "./dist/text-field.js"
    },
    "./textarea.js": {
      "types": "./dist/textarea.d.ts",
      "default": "./dist/textarea.js"
    },
    "./number-field.js": {
      "types": "./dist/number-field.d.ts",
      "default": "./dist/number-field.js"
    },
    "./input-group.js": {
      "types": "./dist/input-group.d.ts",
      "default": "./dist/input-group.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./jsx": {
      "types": "./types/jsx.d.ts"
    },
    "./vue": {
      "types": "./types/vue.d.ts"
    }
  },
  "files": [
    "dist",
    "custom-elements.json",
    "types"
  ],
  "web-types": "./dist/web-types.json",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "web-test-runner && node --import tsx --test src/*.ssr.test.ts",
    "analyze": "custom-elements-manifest analyze --litelement --globs \"src/**/*.ts\" --exclude \"src/**/*.test.ts\" --exclude \"src/**/*.ssr.test.ts\""
  },
  "dependencies": {
    "@lit-material/core": "workspace:*",
    "@lit-material/icon-button": "workspace:*",
    "@lit-material/tokens": "workspace:*",
    "lit": "^3.2.0"
  },
  "peerDependencies": {
    "@lit/react": "^1.0.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@lit/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lit-labs/ssr": "^3.3.1",
    "@open-wc/testing": "^4.0.0",
    "@web/dev-server-esbuild": "^1.0.0",
    "@web/test-runner": "^0.19.0",
    "@web/test-runner-commands": "^0.9.0",
    "@web/test-runner-playwright": "^0.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "customElements": "custom-elements.json"
}
