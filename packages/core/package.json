{
  "name": "@lit-material/core",
  "version": "1.6.0",
  "description": "Shared reactive controllers and helpers (ripple, focus-ring, theme context) for lit-material components.",
  "license": "MIT",
  "author": {
    "name": "bohdaq",
    "email": "bohdaq@gmail.com",
    "url": "https://github.com/bohdaq"
  },
  "homepage": "https://lit.rws8.tech/guides/core/",
  "bugs": "https://github.com/bohdaq/lit-material/issues",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bohdaq/lit-material.git",
    "directory": "packages/core"
  },
  "keywords": [
    "lit",
    "web-components",
    "lit-material",
    "reactive-controller",
    "ripple",
    "focus-ring",
    "context"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./localize.js": {
      "types": "./dist/localize.d.ts",
      "default": "./dist/localize.js"
    },
    "./css-props.js": {
      "types": "./dist/css-props.d.ts",
      "default": "./dist/css-props.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.ssr.test.ts"
  },
  "dependencies": {
    "@lit/context": "^1.1.0",
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0"
  }
}
