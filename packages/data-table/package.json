{
  "name": "@lit-material/data-table",
  "version": "1.3.0",
  "description": "Material Design 3 data table and data grid web components (sortable, selectable, paginated, resizable, virtualized; grouping, inline editing, CSV export).",
  "license": "MIT",
  "author": {
    "name": "bohdaq",
    "email": "bohdaq@gmail.com",
    "url": "https://github.com/bohdaq"
  },
  "homepage": "https://lit.rws8.tech/components/data-table/",
  "bugs": "https://github.com/bohdaq/lit-material/issues",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bohdaq/lit-material.git",
    "directory": "packages/data-table"
  },
  "keywords": [
    "lit",
    "web-components",
    "lit-material",
    "material-design",
    "material-design-3",
    "data-table",
    "data-grid",
    "table",
    "csv"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./csv.js": {
      "types": "./dist/csv.d.ts",
      "default": "./dist/csv.js"
    },
    "./data-grid.js": {
      "types": "./dist/data-grid.d.ts",
      "default": "./dist/data-grid.js"
    },
    "./data-table-cell.js": {
      "types": "./dist/data-table-cell.d.ts",
      "default": "./dist/data-table-cell.js"
    },
    "./data-table-pagination.js": {
      "types": "./dist/data-table-pagination.d.ts",
      "default": "./dist/data-table-pagination.js"
    },
    "./data-table-row.js": {
      "types": "./dist/data-table-row.d.ts",
      "default": "./dist/data-table-row.js"
    },
    "./data-table.js": {
      "types": "./dist/data-table.d.ts",
      "default": "./dist/data-table.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./jsx": {
      "types": "./types/jsx.d.ts"
    },
    "./vue": {
      "types": "./types/vue.d.ts"
    }
  },
  "files": [
    "dist",
    "custom-elements.json",
    "types"
  ],
  "web-types": "./dist/web-types.json",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "web-test-runner && node --import tsx --test src/*.ssr.test.ts",
    "analyze": "custom-elements-manifest analyze --litelement --globs \"src/**/*.ts\" --exclude \"src/**/*.test.ts\" --exclude \"src/**/*.ssr.test.ts\""
  },
  "dependencies": {
    "@lit-material/core": "workspace:*",
    "@lit-material/select": "workspace:*",
    "@lit-material/text-field": "workspace:*",
    "@lit-material/tokens": "workspace:*",
    "lit": "^3.2.0"
  },
  "peerDependencies": {
    "@lit/react": "^1.0.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@lit/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lit-labs/ssr": "^3.3.1",
    "@open-wc/testing": "^4.0.0",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-commands": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "customElements": "custom-elements.json"
}
