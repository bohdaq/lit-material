{
  "name": "@lit-material/sheet",
  "version": "1.2.0",
  "description": "Material Design 3 side sheet and bottom sheet web components (lit-material-side-sheet, lit-material-bottom-sheet).",
  "license": "MIT",
  "author": {
    "name": "bohdaq",
    "email": "bohdaq@gmail.com",
    "url": "https://github.com/bohdaq"
  },
  "homepage": "https://lit.rws8.tech/components/sheet/",
  "bugs": "https://github.com/bohdaq/lit-material/issues",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bohdaq/lit-material.git",
    "directory": "packages/sheet"
  },
  "keywords": [
    "lit",
    "web-components",
    "lit-material",
    "material-design",
    "material-design-3",
    "side-sheet",
    "bottom-sheet"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bottom-sheet.js": {
      "types": "./dist/bottom-sheet.d.ts",
      "default": "./dist/bottom-sheet.js"
    },
    "./side-sheet.js": {
      "types": "./dist/side-sheet.d.ts",
      "default": "./dist/side-sheet.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./jsx": {
      "types": "./types/jsx.d.ts"
    },
    "./vue": {
      "types": "./types/vue.d.ts"
    }
  },
  "files": [
    "dist",
    "custom-elements.json",
    "types"
  ],
  "web-types": "./dist/web-types.json",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "web-test-runner && node --import tsx --test src/*.ssr.test.ts",
    "analyze": "custom-elements-manifest analyze --litelement --globs \"src/**/*.ts\" --exclude \"src/**/*.test.ts\" --exclude \"src/**/*.ssr.test.ts\""
  },
  "dependencies": {
    "@lit-material/tokens": "workspace:*",
    "lit": "^3.2.0"
  },
  "peerDependencies": {
    "@lit/react": "^1.0.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@lit/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lit-labs/ssr": "^3.3.1",
    "@open-wc/testing": "^4.0.0",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-commands": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "customElements": "custom-elements.json"
}
