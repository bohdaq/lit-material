{
  "name": "@lit-material/format",
  "version": "1.2.1",
  "description": "Formatting helpers for lit-material apps: bytes, compact numbers, durations, CPU, and Kubernetes quantities (\"512Mi\", \"500m\"). Locale-aware, no dependencies.",
  "license": "MIT",
  "author": {
    "name": "bohdaq",
    "email": "bohdaq@gmail.com",
    "url": "https://github.com/bohdaq"
  },
  "homepage": "https://lit.rws8.tech/components/format/",
  "bugs": "https://github.com/bohdaq/lit-material/issues",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bohdaq/lit-material.git",
    "directory": "packages/format"
  },
  "keywords": [
    "lit-material",
    "format",
    "bytes",
    "duration",
    "kubernetes",
    "quantity",
    "intl"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "web-test-runner && node --import tsx --test src/*.ssr.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@lit-labs/ssr": "^3.3.1",
    "@open-wc/testing": "^4.0.0",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-commands": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
