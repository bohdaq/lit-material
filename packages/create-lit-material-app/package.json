{
  "name": "create-lit-material-app",
  "version": "0.1.0",
  "description": "Scaffold a new app with lit-material, @lit-material/router, and @lit-material/store already wired together.",
  "license": "MIT",
  "author": {
    "name": "bohdaq",
    "email": "bohdaq@gmail.com",
    "url": "https://github.com/bohdaq"
  },
  "homepage": "https://lit.rws8.tech/guides/create-app/",
  "bugs": "https://github.com/bohdaq/lit-material/issues",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bohdaq/lit-material.git",
    "directory": "packages/create-lit-material-app"
  },
  "keywords": [
    "lit",
    "lit-material",
    "create-app",
    "scaffold",
    "cli",
    "starter"
  ],
  "type": "module",
  "bin": {
    "create-lit-material-app": "./bin/create-lit-material-app.js"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/versions.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "devDependencies": {
    "@lit-material/button": "workspace:*",
    "@lit-material/core": "workspace:*",
    "@lit-material/router": "workspace:*",
    "@lit-material/store": "workspace:*",
    "@lit-material/tokens": "workspace:*",
    "@lit-material/top-app-bar": "workspace:*",
    "@lit-material/vite": "workspace:*",
    "@lit/context": "^1.1.0",
    "@types/node": "^22.0.0",
    "lit": "^3.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
