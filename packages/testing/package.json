{
  "name": "@lit-material/testing",
  "version": "1.2.0",
  "description": "Test helpers for apps built with lit-material: fixtures that wait for every nested Lit update, and role, label and text queries that reach through shadow roots. Works with any browser test runner.",
  "license": "MIT",
  "author": {
    "name": "bohdaq",
    "email": "bohdaq@gmail.com",
    "url": "https://github.com/bohdaq"
  },
  "homepage": "https://lit.rws8.tech/guides/testing/",
  "bugs": "https://github.com/bohdaq/lit-material/issues",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bohdaq/lit-material.git",
    "directory": "packages/testing"
  },
  "keywords": [
    "lit-material",
    "testing",
    "shadow-dom",
    "testing-library",
    "accessibility",
    "web-components"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "web-test-runner"
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@lit-labs/ssr": "^3.3.1",
    "@lit-material/button": "workspace:*",
    "@lit-material/checkbox": "workspace:*",
    "@lit-material/dialog": "workspace:*",
    "@lit-material/tabs": "workspace:*",
    "@lit-material/text-field": "workspace:*",
    "@open-wc/testing": "^4.0.0",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-commands": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
