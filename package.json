{
  "name": "lit-material",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/bohdaq/lit-material.git"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:cross-browser": "WTR_BROWSERS=all turbo run test --concurrency=1",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "analyze": "turbo run analyze",
    "dev": "turbo run dev --parallel",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && pnpm analyze && pnpm bindings && changeset publish",
    "size": "node tools/size-check.mjs",
    "hydration": "node tools/hydration-check.mjs",
    "bindings": "node tools/framework-bindings.mjs",
    "messages": "node tools/messages.mjs",
    "messages:check": "node tools/messages.mjs --check",
    "bindings:check": "node tools/framework-bindings.mjs --check && tsc -p tools/bindings-check && node tools/bindings-check/smoke.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@lit-labs/ssr-client": "1.1.8",
    "@lit/react": "^1.0.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.1",
    "eslint": "^10.7.0",
    "eslint-plugin-chai-friendly": "^1.2.1",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.7.0",
    "playwright": "^1.53.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.64.0",
    "vue": "^3.5.44"
  }
}
